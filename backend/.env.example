PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/barber_booking
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Nodemailer Email Configuration
# Option 1: Gmail (Use App Password from Google Account Security)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Barber Shop" <your_email@gmail.com>

# Option 2: Custom SMTP (e.g. Mailtrap, SendGrid, Hostinger, AWS SES)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

